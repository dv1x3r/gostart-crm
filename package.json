{
  "scripts": {
    "build": "go build -tags \"fts5\" -o ./build/server ./cmd/server/main.go",
    "watch": "concurrently --kill-others --prefixColors=auto bun:watch:*",
    "watch:air": "sleep 4; go tool air --build.cmd \"bun run build\" --build.bin \"./build/server\" --build.include_dir \"cmd,internal,web/dist\" --build.include_ext \"go,js,css\" --build.delay 1000 --build.stop_on_error true --misc.clean_on_exit true",
    "build:templ": "go tool templ generate --path ./internal",
    "watch:templ": "go tool templ generate --path ./internal --watch --proxy=\"http://localhost:1323\" --open-browser=false",
    "build:js": "bun build ./web/src/admin.js ./web/src/client.js --outdir ./web/dist --minify",
    "watch:js": "bun build ./web/src/admin.js ./web/src/client.js --outdir ./web/dist --minify --watch --no-clear-screen",
    "build:css:admin": "tailwindcss -i ./web/src/admin.css -o ./web/dist/admin.css --minify",
    "watch:css:admin": "tailwindcss -i ./web/src/admin.css -o ./web/dist/admin.css --minify --watch",
    "build:css:client": "tailwindcss -i ./web/src/client.css -o ./web/dist/client.css --minify",
    "watch:css:client": "tailwindcss -i ./web/src/client.css -o ./web/dist/client.css --minify --watch",
    "test": "go test -v ./...",
    "db:up": "go tool goose -dir ./migrations sqlite ./build/data.db up",
    "db:up-to": "go tool goose -dir ./migrations sqlite ./build/data.db up-to",
    "db:up-by-one": "go tool goose -dir ./migrations sqlite ./build/data.db up-by-one",
    "db:down": "go tool goose -dir ./migrations sqlite ./build/data.db down",
    "db:down-to": "go tool goose -dir ./migrations sqlite ./build/data.db down-to",
    "db:status": "go tool goose -dir ./migrations sqlite ./build/data.db status",
    "db:reset": "go tool goose -dir ./migrations sqlite ./build/data.db reset",
    "db:create": "go tool goose -dir ./migrations sqlite ./build/data.db create"
  },
  "devDependencies": {
    "@alpinejs/anchor": "^3.14.9",
    "@alpinejs/collapse": "^3.14.9",
    "@alpinejs/focus": "^3.14.9",
    "@tailwindcss/forms": "^0.5.10",
    "alpinejs": "^3.14.9",
    "concurrently": "^9.1.2",
    "htmx.org": "^2.0.4",
    "tailwindcss": "^3.4.17",
    "w2ui": "github:vitmalina/w2ui#b69aeda"
  }
}