package sidebar

import "strings"

type Item struct {
	Link       string
	Label      string
	Icon       string
	IsRoot     bool
	IsExternal bool
}

func (i Item) IsActive(path string) bool {
	if i.IsRoot {
		return i.Link == path
	}
	return strings.HasPrefix(path, i.Link)
}

type Group struct {
	Label string
	Items []Item
}

type SidebarProps struct {
	Path         string
	Label        string
	Link         string
	Address      string
	GroupsTop    []Group
	GroupsMiddle []Group
	GroupsBottom []Group
}

templ Sidebar(props SidebarProps) {
	<section
		x-data="{ sidebarOpen: true, lastWidth: window.innerWidth, sidebarInit() { this.sidebarOpen = window.innerWidth > 639 } }"
		@resize.window.debounce.100="if (this.lastWidth != window.innerWidth) { this.lastWidth = window.innerWidth; sidebarInit(); }"
		x-init="sidebarInit"
		class="flex flex-col h-full"
	>
		<header class="flex justify-between">
			<a href={ templ.URL(props.Link) } class="w-full">
				<div class="text-sm">{ props.Label }</div>
				<div class="text-xs text-zinc-400">{ props.Address }</div>
			</a>
			<button
				@click="sidebarOpen = !sidebarOpen"
				aria-label="Open navbar"
				type="button"
				class="sm:hidden px-2 text-neutral-300 hover:text-white focus:text-white focus:outline-none transition"
				:class="{ 'rotate-180': sidebarOpen }"
			>
				<svg class="h-6 w-6 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
					<path x-show="sidebarOpen" fill-rule="evenodd" clip-rule="evenodd" d="M18.278 16.864a1 1 0 0 1-1.414 1.414l-4.829-4.828-4.828 4.828a1 1 0 0 1-1.414-1.414l4.828-4.829-4.828-4.828a1 1 0 0 1 1.414-1.414l4.829 4.828 4.828-4.828a1 1 0 1 1 1.414 1.414l-4.828 4.829 4.828 4.828z" style="display: none;"></path>
					<path x-show="!sidebarOpen" fill-rule="evenodd" d="M4 5h16a1 1 0 0 1 0 2H4a1 1 0 1 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2z"></path>
				</svg>
			</button>
		</header>
		<nav hx-boost="true" hx-inherit="hx-boost" class="flex flex-col h-full">
			for _, group := range props.GroupsTop {
				<div x-show="sidebarOpen" x-collapse>
					@SidebarGroupList(props, group)
				</div>
			}
			for _, group := range props.GroupsMiddle {
				<div x-show="sidebarOpen" x-collapse>
					@SidebarGroupList(props, group)
				</div>
			}
			for _, group := range props.GroupsBottom {
				<div x-show="sidebarOpen" x-collapse class="mt-auto">
					@SidebarGroupList(props, group)
				</div>
			}
		</nav>
	</section>
}

templ SidebarGroupList(props SidebarProps, group Group) {
	<ul class="space-y-1 mt-2">
		<h2 class="text-sm font-light text-zinc-400">{ group.Label }</h2>
		for _, item := range group.Items {
			<li>
				<a
					href={ templ.URL(item.Link) }
					if item.IsExternal {
						target="_blank"
					}
					class={
						"p-2 w-full text-left flex items-center justify-between rounded-lg transition active:scale-[0.98]",
						templ.KV("hover:bg-zinc-700", item.IsExternal || !item.IsActive(props.Path)),
						templ.KV("bg-zinc-600", !item.IsExternal && item.IsActive(props.Path)),
					}
				>
					<span class="flex items-center truncate">
						<span class={ item.Icon, "w-6 mr-2" } aria-hidden="true"></span>
						<span class="text-sm truncate">{ item.Label }</span>
					</span>
					if item.IsExternal {
						<span class="fa fa-square-arrow-up-right text-sm" aria-hidden="true"></span>
					} else {
						<span class="htmx-indicator animate-spin fa fa-spinner text-sm" aria-hidden="true" x-cloak></span>
					}
				</a>
			</li>
		}
	</ul>
}
